# Настройки сервера. Скопировать в корень репозитория: cp deploy/.env.example .env
# Секреты сгенерировать: openssl rand -hex 32

# адрес сайта: IP сервера через sslip.io (точки заменить на дефисы) - даёт настоящий HTTPS без домена
SITE_ADDRESS=203-0-113-5.sslip.io

JWT_SECRET=
POSTGRES_PASSWORD=
MINIO_PASSWORD=

# LLM МАИ (ключ выдаёт куратор)
LLM_BASE_URL=https://api-ai.mai.ru/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-27b
LLM_CA_FILE=certs/api-ai.mai.ru.pem
LLM_USE_TOOLS=true
