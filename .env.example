# cp .env.example .env и вписать ключ. .env в git не попадает.

LLM_BASE_URL=https://api-ai.mai.ru/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-27b
LLM_CA_FILE=certs/api-ai.mai.ru.pem
LLM_USE_TOOLS=true

# Замените случайной строкой: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=change-me
# Абсолютный срок действия токена с момента входа. Затем нужен повторный вход.
JWT_EXPIRE_MINUTES=60

# для запуска без Docker (в Docker адреса задаются в docker-compose.yml)
CHECKER_URL=http://localhost:8001
FILE_SERVICE_URL=http://localhost:8002
