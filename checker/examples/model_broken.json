{
  "name": "Request",
  "variables": [
    {
      "name": "status",
      "type": "enum",
      "values": [
        "Created",
        "Approved",
        "Cancelled",
        "Executed"
      ],
      "source_ref": "Заявка создаётся, согласуется, отменяется или исполняется"
    },
    {
      "name": "approved",
      "type": "boolean",
      "source_ref": "При согласовании ставится признак approved"
    },
    {
      "name": "cancelled",
      "type": "boolean",
      "source_ref": "Отмена ставит признак cancelled"
    }
  ],
  "initial": {
    "status": "Created",
    "approved": false,
    "cancelled": false
  },
  "transitions": [
    {
      "name": "Approve",
      "guard": {
        "eq": [
          {
            "var": "status"
          },
          "Created"
        ]
      },
      "effects": [
        {
          "set": [
            "status",
            "Approved"
          ]
        },
        {
          "set": [
            "approved",
            true
          ]
        }
      ],
      "source_ref": "Заявку можно согласовать"
    },
    {
      "name": "Cancel",
      "guard": {
        "in": [
          {
            "var": "status"
          },
          [
            "Created",
            "Approved"
          ]
        ]
      },
      "effects": [
        {
          "set": [
            "status",
            "Cancelled"
          ]
        },
        {
          "set": [
            "cancelled",
            true
          ]
        }
      ],
      "source_ref": "Пользователь может отменить заявку до исполнения"
    },
    {
      "name": "Execute",
      "guard": {
        "var": "approved"
      },
      "effects": [
        {
          "set": [
            "status",
            "Executed"
          ]
        }
      ],
      "source_ref": "Исполнить можно, если стоит approved"
    }
  ],
  "properties": [
    {
      "id": "P1",
      "type": "forbidden_state",
      "expression": {
        "and": [
          {
            "eq": [
              {
                "var": "status"
              },
              "Executed"
            ]
          },
          {
            "var": "cancelled"
          }
        ]
      },
      "source_ref": "Отменённая заявка не должна быть исполнена"
    },
    {
      "id": "P2",
      "type": "reachable",
      "expression": {
        "eq": [
          {
            "var": "status"
          },
          "Executed"
        ]
      }
    },
    {
      "id": "P3",
      "type": "deadlock_free",
      "final_states": {
        "in": [
          {
            "var": "status"
          },
          [
            "Executed",
            "Cancelled"
          ]
        ]
      }
    }
  ],
  "description": "Acceptance-тест №1 из ТЗ: Cancel не сбрасывает approved, Execute проверяет только approved"
}